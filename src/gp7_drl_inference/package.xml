<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gp7_drl_inference</name>
  <version>1.0.0</version>
  <description>DRL unified planner node (DDPG/SAC/TD3) for Yaskawa GP7 pick-and-place</description>
  <maintainer email="norman@example.com">Norman</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <build_depend>launch_ros</build_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>gp7_vision_pipeline</depend>
  <depend>gp7_task_executor_msgs</depend>
  <depend>python3-yaml</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
