# Goal
bool execute
float64 velocity_scale

# Vision selection
string target_class
string obstacle_class
bool require_obstacle

# Fallback nếu vision thiếu hoặc muốn test thủ công
bool use_fallback_target
geometry_msgs/Pose fallback_target_pose

bool use_fallback_obstacle
geometry_msgs/Point fallback_obstacle_center
geometry_msgs/Vector3 fallback_obstacle_size

# Opt-in per-goal CSV metrics summary logging (default false: no file written)
bool enable_metrics_log
---
# Result
bool success
string message
string failed_stage

geometry_msgs/PoseStamped target_pose
geometry_msgs/PoseStamped obstacle_pose
geometry_msgs/Vector3 obstacle_size

uint32 trajectory_points
---
# Feedback
string current_stage
float32 progress

geometry_msgs/PoseStamped current_pose
geometry_msgs/PoseStamped target_pose
geometry_msgs/PoseStamped obstacle_pose
