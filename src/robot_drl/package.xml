<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_drl</name>
  <version>1.0.0</version>
  <description>DRL unified planner node (DDPG/SAC/TD3) for robot pick-and-place</description>
  <maintainer email="norman@example.com">Norman</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>ament_index_python</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>ros_gz_interfaces</depend>
  <depend>shape_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>robot_task_executor_msgs</depend>
  <depend>robot_vision_pipeline</depend>
  <depend>python3-yaml</depend>

  <exec_depend>robot_bringup</exec_depend>
  <exec_depend>robot_task_executor</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
