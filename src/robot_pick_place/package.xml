<?xml version="1.0"?>
<package format="3">
  <name>robot_pick_place</name>
  <version>0.1.0</version>
  <description>PyQt6 GUI for ArUco-based pick and place using robot_task_manager/PickPlace action.</description>
  <maintainer email="tranminhquang617@gmail.com">Minh Quang Tran</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>robot_vision_pipeline_msgs</exec_depend>
  <exec_depend>robot_task_manager</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pyqt6</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
