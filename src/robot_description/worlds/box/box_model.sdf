<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="box">
    <static>false</static>

    <link name="link">
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001067</ixx>
          <iyy>0.0001067</iyy>
          <izz>0.0001067</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <!-- Kich thuoc box: dai rong cao, don vi met -->
            <size>0.12 0.16 0.1</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <!-- Giu cung kich thuoc voi collision -->
            <size>0.12 0.16 0.1</size>
          </box>
        </geometry>

        <material>
          <!-- Mau trang de YOLO / camera de tach voi background den -->
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
          <emissive>0.0 0.0 0.0 1.0</emissive>
        </material>

        <cast_shadows>true</cast_shadows>
      </visual>
    </link>
  </model>
</sdf>
