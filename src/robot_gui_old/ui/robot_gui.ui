    <property name="styleSheet">
     <string>QFrame#SideMenu {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #2ba1c3, stop:1 #b8e5ec);
}

QFrame#SideMenu QPushButton {
    color: #001b45;
    border: 0px;
    border-radius: 8px;
    padding: 8px 12px;
    text-align: left;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #67c1d1, stop:1 #3ba2bf);
}

QFrame#SideMenu QPushButton:hover {
    color: white;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #008dbe, stop:1 #004b78);
}

QFrame#SideMenu QPushButton:checked {
    color: white;
    font-weight: bold;
    border-left: 5px solid #ffffff;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #006f9f, stop:1 #003b63);
}

QFrame#SideMenu QPushButton:checked:hover {
    color: white;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #007fb5, stop:1 #004b78);
}</string>
