    border: 1px solid #a5d6a7;
}
#btnRobotEnable:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1b5e20, stop:1 #0d3d12);
    border: 1px solid #0b2e0f;
    padding-top: 3px;
